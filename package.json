{
  "name": "explainer-studio",
  "description": "A local studio for AI-made, 3Blue1Brown-style explainer videos: watch with a synced transcript, ask Claude about any moment, build an Obsidian knowledge vault, and create new videos from a brief.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.ts",
    "typecheck": "tsc --noEmit",
    "test": "STUDIO_CONFIG=test/studio.test.config.json node --disable-warning=ExperimentalWarning --test --test-concurrency=1 'test/**/*.test.ts'",
    "e2e": "STUDIO_CONFIG=test/studio.test.config.json node --disable-warning=ExperimentalWarning --test --test-concurrency=1 'e2e/**/*.test.ts'",
    "learn": "STUDIO_CONFIG=test/studio.test.config.json node --disable-warning=ExperimentalWarning learning-tests/agent-sdk/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "puppeteer-core": "25.13.0",
    "typescript": "5.9.3"
  }
}
